# Variable NAMES and safe local defaults only. Never commit a real credential.
# Real secrets are supplied through the environment or a secret manager.
#
# Startup validation (src/config/env.ts) refuses to boot when something is
# missing, and refuses APP_ENV=production together with a local-test adapter.

# development | test | production
APP_ENV=development

# local | sandbox | live
# `local` enables the development-only adapters and is rejected in production.
INTEGRATION_MODE=local

# PostgreSQL. `docker compose up -d` starts the local database on port 5433.
DATABASE_URL=postgres://hamzist:hamzist_local_dev@127.0.0.1:5433/hamzist

# Optional. Test suites create their own isolated database on this server.
# TEST_DATABASE_URL=postgres://hamzist:hamzist_local_dev@127.0.0.1:5433/hamzist

# Private uploads live here, outside the public tree. Never served directly.
PRIVATE_STORAGE_DIR=private-storage

# Public origin of the site (no path). Canonical links, the sitemap and
# OpenGraph are built from it. Required in production, and only https there.
# Outside production an unset value means http://localhost:3111.
# SITE_URL=

# Required in production only. At least 32 characters, from a secret manager.
# SESSION_SECRET=

# Provider identifiers. Leaving one unset reports NOT_CONFIGURED, which is a
# truthful state — it is not replaced by a fake provider.
# SMS_PROVIDER=
# PAYMENT_PROVIDER=
# MAP_PROVIDER=
# DOCUMENT_RENDERER=
# اتصال ریدر میکروچیپ (بلوتوث یا متصل به موبایل). تا پیکربندی، ورود دستی و بارکد بسته کار می‌کنند.
# CHIP_READER_PROVIDER=

# Product values such as referral_validity_days=21, membership fee 300000 Toman
# and the 14 day / six calendar month cooldown live in DB product settings and
# are managed from the admin panel — never in environment variables or code.
